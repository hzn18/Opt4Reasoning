+# SPDX-License-Identifier: Apache-2.0
+from typing import Optional, Dict, Any, Tuple
+import torch
+import logging, json
+import cvxpy as cp
+from cvxpylayers.torch import CvxpyLayer
+import numpy as np
+
+from .template import AlgorithmTemplate
+from .factory import register_algorithm
+
+logger = logging.getLogger(__name__)
+
+
+@register_algorithm("projection")
+class ProjectionAlgorithm(AlgorithmTemplate):
+    """
+    Constrained-projection algorithm (online).
+
+    1. Map the hidden state into the PCA-reduced latent space.
+    2. Solve for the closest point to the origin that satisfies every SVC
+       constraint, using a CvxpyLayer.
+    3. Apply the resulting displacement back to the original hidden state.
+    """
+
+    def _create_steer_layer(self, qp_params: dict):
+        """Build the CVXPY layer: minimize ||x - target_pca||^2 subject to the SVC constraints."""
+        pca_components = qp_params["pca"]["components"]
+        dim = len(pca_components)
+        
+        x = cp.Variable(dim)
+        target_pca = cp.Parameter(dim)
+        
+        constraints = []
+        # One constraint per SVC: w^T x + b <= 0
+        for k, v in qp_params.items():
+            if "svc" in k:
+                # Convert to a cp constant once, outside the solve, for efficiency
+                coef = np.array(v["coef"]).flatten()
+                intercept = v["intercept"]
+                constraints.append(coef @ x + intercept <= 0.0)
+
+        prob = cp.Problem(cp.Minimize(cp.sum_squares(x - target_pca)), constraints)
+        # A layer callable from PyTorch that stays differentiable end to end
+        return CvxpyLayer(prob, parameters=[target_pca], variables=[x])
+
+    def _transform(self, hidden_state: torch.Tensor, params: dict) -> torch.Tensor:
+        """
+        Apply the projection intervention.
+
+        hidden_state is expected to have shape [batch, seq_len, hidden_dim].
+        """
+        qp_layer = params["qp_layer"]
+        pca_comp = params["pca_comp"]
+        s_mean = params["s_mean"]
+        scale_factor = params.get("scale_factor", 1.0)
+
+        dtype = hidden_state.dtype
+
+        # 1. Project into the PCA latent space -> [batch, hidden_dim] -> [batch, dim]
+        target_h = hidden_state
+        h_pca = (target_h - s_mean) @ pca_comp.T
+
+        # 2. Solve the QP. The layer expects a float32 [batch, dim] input; the
+        #    PCA parameters are already on the right device from load_from_path.
+        new_pca, = qp_layer(h_pca.to(torch.float32))
+        new_pca = new_pca.to(dtype)
+
+        # 3. Map the latent displacement back to the model's hidden space
+        delta_pca = new_pca - h_pca
+        steer_vec = delta_pca @ pca_comp
+
+        # 4. Apply the intervention, scaled by the steering strength
+        output = target_h + scale_factor * steer_vec
+
+        return output
+
+    @classmethod
+    def load_from_path(cls, file_path: str, device: str, config=None, target_layers=None):
+        """Load the PCA, scaler, and SVC parameters from a JSON file and build the optimization layer."""
+        try:
+            with open(file_path, 'rb') as f:
+                qp_params = json.load(f)
+
+            # Instantiate so the helper below can be called
+            instance = cls()
+
+            # Build the CvxpyLayer once and reuse it for every target layer
+            qp_layer = instance._create_steer_layer(qp_params).to(device)
+
+            # Tensors needed by _transform
+            s_mean = torch.tensor(qp_params["scaler"]["mean"]).float().to(device)
+            pca_comp = torch.tensor(qp_params["pca"]["components"]).float().to(device)
+
+            layer_payloads = {}
+            if target_layers is None:
+                target_layers = list(range(getattr(config, "num_hidden_layers", 48)))
+
+            for layer_idx in target_layers:
+                layer_payloads[layer_idx] = {
+                    "qp_layer": qp_layer,
+                    "pca_comp": pca_comp,
+                    "s_mean": s_mean
+                }
+
+            return {"layer_payloads": layer_payloads}
+
+        except Exception as e:
+            logger.error(f"Error loading projection parameters: {e}")
+            raise RuntimeError(f"Failed to load projection config from {file_path}") from e
