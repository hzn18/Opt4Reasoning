+# SPDX-License-Identifier: Apache-2.0
+from typing import Optional, Dict, Any, Tuple
+import torch
+import logging, json
+import numpy as np
+
+from .template import AlgorithmTemplate
+from .factory import register_algorithm
+
+
+logger = logging.getLogger(__name__)
+
+
+@torch.compile(mode="max-autotune")
+def _compiled_qp_projection(target_h, pca_comp, s_mean, Ath, bth, K_all, k_all, scale_factor):
+    # target_h: [B, D]
+    h_pca = (target_h - s_mean) @ pca_comp.T
+
+    B = h_pca.size(0)
+    N, C, D = Ath.shape
+
+    # Point-location lookup, in FP32 so that the boundary tests are not
+    # perturbed by the model's lower-precision dtype.
+    h_pca_f32 = h_pca.to(torch.float32)
+    Ath_flat = Ath.view(-1, D)
+
+    A_theta = (h_pca_f32 @ Ath_flat.T).view(B, N, C)
+
+    # A region is active when all of its facet constraints hold
+    is_valid = A_theta <= (bth.unsqueeze(0))
+    valid_regions = is_valid.all(dim=-1) # [B, N]
+
+    has_valid = valid_regions.any(dim=-1) # [B]
+    region_idx = valid_regions.int().argmax(dim=1) # [B]
+
+    # Gather the affine solution (K, k) of the selected regions
+    K_sel = K_all[region_idx] # [B, D, D]
+    k_sel = k_all[region_idx] # [B, D]
+
+    new_pca_f32 = torch.bmm(K_sel, h_pca_f32.unsqueeze(2)).squeeze(2) + k_sel
+
+    # Cast back to the model's dtype, inferred from target_h
+    new_pca = new_pca_f32.to(target_h.dtype)
+    
+    delta_pca = new_pca - h_pca
+    delta_pca = torch.where(has_valid.unsqueeze(-1), delta_pca, torch.zeros_like(delta_pca))
+
+    steer_vec = delta_pca @ pca_comp
+    return target_h + scale_factor * steer_vec
+
+@register_algorithm("projection-offline")
+class ProjectionOFFAlgorithm(AlgorithmTemplate):
+    """
+    Constrained-projection algorithm (offline).
+
+    1. Offline: the SVC constraints are turned into an mpQP, which is solved
+       for every critical region (CR) and its affine solution (K, k). See
+       qp_offline.py.
+    2. Online: the region boundaries are stacked into dense tensors and a
+       fully vectorised GPU point-location over the whole batch finds each
+       hidden state's region, after which z = K * theta + k.
+    """
+
+    def _transform(self, hidden_state: torch.Tensor, params: dict) -> torch.Tensor:
+        original_shape = hidden_state.shape
+
+        # Flatten batch and seq_len into a single [B, hidden_dim] dimension
+        target_h = hidden_state.reshape(-1, original_shape[-1])
+
+        output_flat = _compiled_qp_projection(
+            target_h,
+            params["pca_comp"],
+            params["s_mean"],
+            params["Ath"],
+            params["bth"],
+            params["K"],
+            params["k"],
+            params.get("scale_factor", 1.0)
+        )
+
+        return output_flat.reshape(original_shape)
+
+    @classmethod
+    def load_from_path(cls, file_path: str, device: str, config=None, target_layers=None):
+        import os
+        try:
+            # Load the precomputed tensors straight onto the target device
+            tensors = torch.load(file_path, map_location=device, weights_only=True)
+
+            layer_payloads = {}
+            if target_layers is None:
+                target_layers = list(range(getattr(config, "num_hidden_layers", 48)))
+
+            # Share the same payload across every target layer. The region
+            # tensors are forced to float32 for the point-location lookup.
+            for layer_idx in target_layers:
+                layer_payloads[layer_idx] = {
+                    "Ath": tensors["Ath"].to(device).float(),
+                    "bth": tensors["bth"].to(device).float(),
+                    "K": tensors["K"].to(device).float(),
+                    "k": tensors["k"].to(device).float(),
+                    # PCA components stay in the model's dtype
+                    "pca_comp": tensors["pca_comp"].to(device),
+                    "s_mean": tensors["s_mean"].to(device)
+                }
+
+            return {"layer_payloads": layer_payloads}
+
+        except Exception as e:
+            logger.error(f"Error loading projection tensors: {e}")
+            raise RuntimeError(f"Failed to load compiled tensors from {file_path}") from e
